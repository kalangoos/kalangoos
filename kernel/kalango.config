# KalangoOS · fragmento de configuração do kernel, aplicado sobre a configuração do Ubuntu.
# Tudo o que o kalangod e o isolamento dos agentes precisam do kernel (docs/ARQUITETURA.md, seção 3).

# eBPF com informações de tipo (regras e auditoria escritas em Rust com Aya)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_EVENTS=y

# Módulos de segurança: Landlock e eBPF LSM ativos por padrão (sem parâmetro de inicialização)
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_BPF_LSM=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"

# Isolamento de tarefas: cgroups v2, namespaces, seccomp
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Auditoria de arquivos (linha do tempo independente do agente)
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# Pontos de restauração
CONFIG_BTRFS_FS=y

# Identificação da versão
CONFIG_LOCALVERSION="-kalango"
