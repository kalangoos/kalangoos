#!/bin/sh
# KalangoOS · início da sessão gráfica (chamado pela tela de entrada).
# Usa a configuração do compositor do KalangoOS; quem quiser personalizar copia para ~/.config/kalango/niri.kdl.
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/kalango/niri.kdl" ]; then
    export NIRI_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/kalango/niri.kdl"
else
    export NIRI_CONFIG=/usr/share/kalango/niri.kdl
fi
export XDG_CURRENT_DESKTOP=KalangoOS:niri
export XDG_SESSION_DESKTOP=kalango
# screen capture and input injection only for who kalangod allows (niri patch 0008; the file belongs to root)
export KALANGO_NIRI_CONTROLE=/run/kalango/controle-remoto
# Esc Esc encerra a sessão de controle remoto em qualquer janela (patch 0009 do niri)
export KALANGO_ESC_DUPLO="/usr/bin/kalango-remote end-sessions"
# o mouse ou o teclado da pessoa enquanto um agente controla a tela: o agente para (patch 0011 do niri)
export KALANGO_PESSOA_ATIVA="/usr/libexec/kalango/kalangod tela pessoa"
# o niri-session importa este ambiente para o systemd do usuário e sobe niri.service; ao chegar em
# graphical-session.target, sobem kalango-shell.service e kalango-aprovacao.service
exec niri-session -l
