# Unidade do usuário (/usr/lib/systemd/user/): o shell da sessão KalangoOS.
[Unit]
Description=KalangoOS · shell (barra, dock, área de trabalho, notificações)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

StartLimitIntervalSec=0

[Service]
ExecStart=/usr/libexec/kalango/kalango-shell
# supervisão: se cair, volta em 200 ms (meta da fase 1: menos de 1 s)
Restart=always
RestartSec=200ms
# sem limite de reinícios em sequência: o shell é a interface, não pode desistir

[Install]
WantedBy=graphical-session.target
