[Desktop Entry]
Type=Application
Name=Música
Name[en]=Music
Comment=As músicas da sua pasta Música, com mixes montados pelo agente
Comment[en]=The songs in your Music folder, with mixes the agent makes
Exec=kalango-shell musica %f
Icon=audio-x-generic
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/x-wav;audio/wav;
StartupWMClass=os.kalango.Musica
Keywords=música;musica;music;songs;player;tocar;
