[Unit]
Description=KalangoOS · plataforma dos agentes da pessoa
Documentation=https://kalangoos.com
# Onde roda o kalango-fluxosd (o drop-in kalango-fluxos.service.d/10-plataforma.conf o põe aqui). O nome faz desta fatia uma
# filha de kalango-agentes.slice: para a política do kalangod (aprovação, lista de permitidos) o serviço continua sendo
# "agente". A guarda eBPF do kernel, porém, a isenta: o serviço é o dono das pastas que a guarda protege dos agentes
# (~/.local/share/kalango/fluxos, o banco dos fluxos e das aprovações) e, dentro da fatia dos agentes, não abria o próprio
# banco. Ativa e vazia desde o início da sessão: o kalangod já a registrou quando o serviço nasce.

[Slice]
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes

[Install]
WantedBy=default.target
