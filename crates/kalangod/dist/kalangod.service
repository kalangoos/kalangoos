[Unit]
Description=KalangoOS · MCP do sistema (kalangod)
Documentation=https://kalangoos.com
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/libexec/kalango/kalangod servir --config /etc/kalango/kalangod.toml
RuntimeDirectory=kalango
RuntimeDirectoryMode=0755
StateDirectory=kalango
StateDirectoryMode=0700
Restart=on-failure
RestartSec=1
# O serviço é root por desenho (opera o sistema). Ele mesmo só ouve no soquete Unix, mas os programas que executa
# (apt, nmcli, ufw, udisksctl, systemd-run) precisam de rede, netlink e D-Bus, então a rede não é cortada aqui.
# As tarefas dos agentes rodam fora deste serviço, em kalango-agentes.slice, com limites próprios.
LockPersonality=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
