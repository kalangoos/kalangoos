           case "$VERSAO" in 0.*|*-*) prerelease="--prerelease" ;; esac
           gh release create "$TAG" dist/* --draft $prerelease --verify-tag \
             --title "KalangoOS $VERSAO" \
-            --notes "KalangoOS $VERSAO: a ISO para instalar (x86_64, UEFI; testada numa VM: sessão ao vivo, instalação e o primeiro boot do sistema instalado) e os binários. Em desenvolvimento: veja o README."
+            --notes "KalangoOS $VERSAO: a ISO para instalar (x86_64, UEFI; testada numa VM: sessão ao vivo, instalação e o primeiro boot do sistema instalado) e os binários. Quando a ISO traz o Kalango VirtualDesk (GPL-3.0-or-later), o código-fonte correspondente está nesta mesma versão, no arquivo kalango-virtualdesk-<commit>-src.tar.gz. Em desenvolvimento: veja o README."
